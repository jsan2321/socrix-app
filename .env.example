# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Provider Configuration
# Active provider choice: 'openai' | 'qwen' | 'deepseek'
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# API Keys (Node runtime only - NEVER prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=your-openai-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Reserved Fallback Options (Phase 2)
AI_FALLBACK_PROVIDER=qwen
AI_FALLBACK_MODEL=qwen-plus

# Embedding & Ingestion Configuration
EMBEDDING_MODEL=text-embedding-3-small
MAX_UPLOAD_MB=50
MAX_INGESTION_SECONDS=50
